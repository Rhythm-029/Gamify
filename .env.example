VITE_GOOGLE_CLIENT_ID=579864871614-o90r392pup5745p87u54opq0skf52q19.apps.googleusercontent.com
GOOGLE_CLIENT_ID=579864871614-o90r392pup5745p87u54opq0skf52q19.apps.googleusercontent.com
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=fresh-linkedin-profile-data.p.rapidapi.com
PORT=4000

# ── Game Backend ──────────────────────────────────────────────────────────────
# MongoDB — use Atlas connection string in production
MONGODB_URI=mongodb://localhost:27017

# Redis — use Upstash URL in production
REDIS_URL=redis://localhost:6379

# ── LLM — Grok (xAI) is the primary model ────────────────────────────────────
# Get key at: https://console.x.ai/
XAI_API_KEY=xai-your-key-here
LLM_BASE_URL=https://api.x.ai/v1
LLM_MODEL=grok-3

# OpenAI fallback (only needed if NOT using Grok)
# OPENAI_API_KEY=sk-...

# ── Whisper transcription ─────────────────────────────────────────────────────
# Option A: OpenAI Whisper (uses OPENAI_API_KEY above)
WHISPER_PROVIDER=openai

# Option B: Groq Whisper — faster + free tier
# WHISPER_PROVIDER=groq
# GROQ_API_KEY=gsk_your-groq-key-here

# Storage: 'local' writes to /uploads/ — swap for S3/R2 in production
STORAGE_ADAPTER=local
# S3_BUCKET=your-bucket-name
# AWS_REGION=us-east-1
